{
    "name": "progress-service",
    "version": "1.0.0",
    "description": "Microservice for managing student progress and submissions",
    "main": "server.js",
    "scripts": {
        "dev": "nodemon ./src/server.js",
        "prod": "cross-env PROGRESS_BACKEND_ENV=production node ./src/server.js",
        "test": "node node_modules/jest/bin/jest.js --detectOpenHandles --runInBand --forceExit --coverage"
    },
    "jest": {
        "testEnvironment": "node",
        "testMatch": [
            "**/tests/**/*.test.js"
        ],
        "collectCoverage": true,
        "coverageDirectory": "coverage",
        "coverageReporters": [
            "lcov",
            "text",
            "clover"
        ]
    },
    "dependencies": {
        "axios": "^1.15.2",
        "compression": "^1.7.4",
        "cors": "^2.8.5",
        "cross-env": "^7.0.3",
        "dotenv": "^17.2.3",
        "express": "^4.18.2",
        "express-async-handler": "^1.2.0",
        "express-mongo-sanitize": "^2.2.0",
        "express-rate-limit": "^8.2.2",
        "express-validator": "^7.0.1",
        "express-xss-sanitizer": "^2.0.2",
        "helmet": "^8.1.0",
        "jsonwebtoken": "^9.0.3",
        "mongoose": "^8.20.0",
        "morgan": "^1.10.0",
        "prom-client": "^15.1.0",
        "sucrase": "^3.35.1"
    },
    "overrides": {
        "qs": "^6.14.2",
        "lodash": "^4.18.1",
        "picomatch": "^4.0.4"
    },
    "devDependencies": {
        "jest": "^29.7.0",
        "nodemon": "^3.1.11",
        "supertest": "^6.3.4"
    }
}
